+void GRenderWindow::CaptureRsaFrame(const std::string& source, const QString& path, std::function<void(std::string)> done) {
+    if (!system.IsPoweredOn()) { done("NO_GAME"); return; }
+    if (!emu_thread || !emu_thread->IsRunning() || system.frame_limiter.IsFrameAdvancing()) {
+        done("PAUSED"); return;
+    }
+    auto& renderer = system.GPU().Renderer();
+    if (renderer.IsScreenshotPending()) { done("CAPTURE_BUSY"); return; }
+    const bool top = source == "top";
+    Layout::FramebufferLayout layout{};
+    layout.width = top ? Core::kScreenTopWidth : Core::kScreenBottomWidth;
+    layout.height = top ? Core::kScreenTopHeight : Core::kScreenBottomHeight;
+    layout.top_screen_enabled = top;
+    layout.bottom_screen_enabled = !top;
+    (top ? layout.top_screen : layout.bottom_screen) = {0, 0, layout.width, layout.height};
+    layout.is_rotated = true;
+    layout.raw_capture = true;
+    layout.render_3d_mode = Settings::StereoRenderOption::Off;
+    auto image = std::make_shared<QImage>(QSize(layout.width, layout.height), QImage::Format_RGB32);
+    renderer.RequestScreenshot(image->bits(), [image, path, done = std::move(done)](bool invert_y) {
+        done(GetMirroredImage(*image, false, invert_y).save(path) ? "" : "CAPTURE_SAVE_FAILED");
+    }, layout);
+}
